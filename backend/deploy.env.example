# Deploy-ready environment template for Render / production
# Copy to .env or set these values in your Render/hosting dashboard

APP_NAME="DawaKhana"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-frontend.netlify.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (MySQL) - set according to your managed DB
DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_SOCKET=
DATABASE_URL=

# Sanctum / CSRF
SANCTUM_STATEFUL_DOMAINS=your-frontend.netlify.app
SESSION_DOMAIN=your-frontend.netlify.app

# Queues & caching
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mail (use a real mailer in production)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: set PORT to allow Docker entrypoint override (Render sets this automatically)
PORT=10000
